# Copy to .env on the server. Never commit real secrets.
# Neon pooled connection string. Configure separately in Vercel and GitHub Secrets.
DATABASE_URL=
SITE_ORIGIN=https://your-domain.example
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
# Public-account sandbox: web authorization for followed test users. Push stays off.
WECHAT_OA_SANDBOX=false
# Token chosen for the public-account server verification endpoint.
WECHAT_CALLBACK_TOKEN=
# Desktop QR / native quick authorization: approved WeChat Open Platform website app.
# Can be configured independently of the Official Account above.
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
# Only enable after the account has an approved template for the subscribed service.
WECHAT_TEMPLATE_ID=
# Keys must match the actual approved template. Values: skin,price,previous,time,holes,summary.
# Sandbox template example: 内容: {{content.DATA}} ; mapping: {"content":"summary"}
WECHAT_TEMPLATE_FIELDS={}
WECHAT_SEND_ENABLED=false
# Upcoming public lottery window, 1–24 hours; default 6. Does not enable early purchase alerts.
LOTTERY_UPCOMING_HOURS=6
