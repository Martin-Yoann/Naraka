{
  "name": "zhexing-market",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start",
    "test": "node --test",
    "import": "node scripts/import.mjs",
    "build:vercel": "npm run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/cloud-db.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-cloud.mjs",
    "collect": "node --env-file-if-exists=.env scripts/collect.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-cloud.mjs",
    "dev": "node scripts/prepare-next.mjs && next dev",
    "build": "node scripts/prepare-next.mjs && next build",
    "start:local": "node server.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
