{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,dist/inventory/**,dist/atlas/**,artifacts/**,test/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?route=:path*"},
    {"source": "/catalog.json", "destination": "/api/index?route=catalog"}
  ]
}
